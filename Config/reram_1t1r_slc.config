
; --- MBMM Infrastructure ---
MAP_ADDRESS true
DECODER MigratingDecoder
INTERCONNECT OffChipBus
STATS_OUT nvmain_stats_1t1r_slc.out
CPUFreq 800

; --- Clock and Controller ---
CLK 800
MEM_CTL FRFCFS
; Simple mapping R:BK:C prevents the pos(8) substr crash
AddressMappingScheme R:BK:C
BusWidth 64
DeviceWidth 8
RATE 2

; --- Timing Parameters (Cycles) ---
tCAS 26
tRCD 26
tRP 1       
tRAS 26
tWR 26
tRTW 26
tBus 4
tCMD 1

; --- Energy and Power ---
ReadEnergy 1.191
WriteEnergy 1.738
StandbyPower 794.656

; --- Geometry ---
; High power-of-two values ensure the bit-string size remains > 8
ROWS 65536
COLS 1024
CHANNELS 1
RANKS 1
BANKS 8
MATHeight 65536

; --- NVM Specific Logic ---
ClosePage 1
UseRefresh false
UsePrecharge true
