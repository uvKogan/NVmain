; Memory configuration file examples 
; As an example, the Micron DDR3-1333_4Gb_8B_x8 memory chip is defined
 
;================================================================================
; Interface specifications

; 666 MHz clock (1333 MT/s DDR). Clock period = 1.5 ns
CLK 2400

; Data Rate. 1 for SDR, 2 for DDR
RATE 2

; Bus width in bits. JEDEC standard is 64-bits
BusWidth 64

; Number of bits provided by each device in a rank
; Number of devices is calculated using BusWidth / DeviceWidth.
DeviceWidth 8

; NVMain use CLK 2400
; is actually used. So a simple CLK=1 and CPUFreq=4 still works for simulation. 
; However, it is straightforward to make it informative.
CPUFreq 3000
;================================================================================

;********************************************************************************
; General memory system configuration

; Number of banks per rank 
BANKS 32

; Number of ranks per channel
RANKS 2

; Number of channels in the system
CHANNELS 2

; Number of rows in one bank
ROWS 65536

; Number of VISIBLE columns in one LOGIC bank 
COLS 32

; whether enable sub-array level parallelism (SALP)
; options: 
;   No SALP: MATHeight = ROWS
;   SALP: number of subarrays = ROWS / MATHeight
MATHeight 65536

; Whether use refresh? 
UseRefresh true

; the refresh granularity (the number of banks refreshed together in a rank)
; this must NOT be 0 when UseRefresh is true
; JEDEC recalibration (finding #7, 2026-07-11): DDR5 REFab is all-bank, so set
; to BANKS (32) for a single synchronized all-bank refresh event per rank
; rather than the inherited-from-template 8-of-32 grouping. Verified
; algebraically (and re-verified against the re-run) that this does NOT change
; total refresh energy/power -- SubArray's per-subarray charge
; (EIDD5B-EIDD3N)*tRFC/BANKS times BanksPerRefresh simultaneous subarray calls
; per event, times BANKS/BanksPerRefresh events per tREFI window, is
; (EIDD5B-EIDD3N)*tRFC regardless of BanksPerRefresh. This only changes
; concurrency realism (all banks blocked together during tRFC, matching REFab)
; and the per-bank refresh-event count/size split, not the module-sum total.
BanksPerRefresh 32

; RefreshRows is the number of rows to refresh per refresh operation
; for example, RefreshRows = ROWS/8192 for DRAM
; JEDEC recalibration: ROWS/8192 = 65536/8192 = 8, matching JEDEC's 8192 REF
; commands per tREFW window (was 4, inherited from the DDR3-1333 template).
RefreshRows 8

; the number of refresh that can be delayed
; options: 1 -- 8 (DDR-3 defines the maximum 9*tREFI)
; when 1 is applied, immediate refresh is used, otherwise the refresh can be
; delayed
DelayedRefreshThreshold 1; 
;********************************************************************************

;================================================================================
; Memory device timing parameters (in memory cycle) 

tBURST 8

tCMD 1 
tRAS 77
; Corrected 2026-08: tCAS/tRCD/tRP were 34-34-34 (unsourced/placeholder).
; Real DDR5-4800 standard (non-3DS) speed bin per SK hynix part-number decoder
; (documents/reference_validation_papers/TR-20230620152301091.pdf,
; TR-20230620152301412.pdf, code "EB" = "4800 40-39-39") is 40-39-39.
; [10] (JESD79-5D) itself remains access-gated; this is the best available
; grounding — see docs/superpowers/plans/2026-07-29-book-reference-fixes.md.
tRCD 39
tAL 0
tCCD 4
tCWD 7
tWTR 5
tWR 10
tRP 39
tCAS 40

tRTRS 1 ; for DDR-1, tRTRS can be 0
tRTP 5
; JEDEC recalibration (finding #7): tRFC1 @ 16Gb = 295ns * CLK(2400MHz) = 708
; cycles. Old value (107 cycles = 44.58ns @ 2400MHz) reverse-solves to 160.5ns
; at the DDR3-1333 template's original 666.667MHz/1.5ns clock -- inherited,
; never rescaled when CLK was overridden to 2400 for this DDR5 config.
tRFC 708
tOST 1 ; ODT switching time

tRRDR 5 ; tRRDR is used for tRRD by default
tRRDW 5

; Row Activation Window (RAW), which specifies the maximum Activation in a
; rolling window. tRAW is the corresponding window width (in cycle).
; Options:
;   for 2D DRAM, RAW = 4, Four Activation Window (FAW)
;   for WideI/O DRAM, RAW = 2, Two Activation Window (TAW)
RAW 4
tRAW 20

; powerdown mode enter and exit 
tRDPDEN 24
tWRPDEN 19
tWRAPDEN 22
tPD 6
tXP 6
tXPDLL 17
tXS 5
tXSDLL 512

; refresh window between two refreshes to a cell (in cycle, e.g., 64ms/tCK)
; options: for DDR3, 64ms (normal) or 32ms (thermal extended)
;          for LPDDR3, 32ms (normal) or 16ms (thermal extended)
;          for 3D DRAM, 32ms/16ms/8ms are all possible
; JEDEC recalibration (finding #7, 2026-07-11): DDR5 tREFW = 32ms * CLK(2400MHz)
; = 76,800,000 cycles. Old value (42,666,667 cycles) reverse-solves to exactly
; 64ms at 666.667MHz/1.5ns -- the DDR3-1333 template's clock, carried over
; unrescaled when CLK was overridden to 2400 for this DDR5 config (see the
; stale "666 MHz clock... Clock period = 1.5ns" comment at the top of this
; file). NVMain's "current" EnergyModel (StandardRank.cpp:977-995) computes
; simulationTime as raw elapsed cycles with no separate CLK-to-ns conversion,
; so cycles here must equal real_seconds * CLK directly -- confirmed no hidden
; internal clock domain applies.
tREFW 76800000
;================================================================================

;********************************************************************************
; Memory device energy and power parameters
 
; Read/write values are in nano Joules
; NOTES:
;   NVSIM energy is per word
;   Erd is the read energy from a single mat
;   Ewr is the write energy (SET or RESET, they are the same)
;   These values are the energys required to read a page into a row buffer.
;
;   Other energy values are taken from CACTI
;

; whether use low power mode?
UseLowPower true

; PowerDown mode 
; Option:
;    FASTEXIT: Precharge PowerDown with Fast Exit
;    SLOWEXIT: Precharge PowerDown with Slow Exit
;    <TO DO>: extend to support more power down mode 
PowerDownMode FASTEXIT

EnergyModel current

; Subarray write energy per bit
Ewrpb 0.000202

Erd 3.405401
Eopenrd 1.081080
Ewr 1.023750
Eref 38.558533
Eactstdby 0.090090
Eprestdby 0.083333
Epda 0.000000
Epdpf 0.078829
Epdps 0.000000

; DRAM style power calculation. All values below in mA, taken from datasheet.

; JEDEC recalibration (finding #8a, 2026-07-11): DDR5 VDD/VDDQ = 1.1V per
; JESD79-5 (was 1.5V, the DDR3/DDR4-era default -- also literally NVMain's
; stock Params.cpp class default, never customized for this config at all).
Voltage 1.1

; Finding #8b (cycle 6c, 2026-07-12): EIDD0-EIDD5B current magnitudes sourced
; from SK hynix 16Gb DDR5 datasheet, x8 @ DDR5-4800 ("hynix floor" -- the
; headline config, persisted here; a Micron-ceiling variant was run in
; parallel as a band, see results/system_v2_3B/ and the cycle-6c report at
; results/cycle6c_ddr5_calibration_and_provenance_report.md). hynix does not
; publish IDD2P/IDD3P: EIDD2P0/EIDD2P1 = Micron IDD2P(88) x hynix:Micron
; IDD2N ratio (49/92) = 46.87; EIDD3P = Micron IDD3P(140) x hynix:Micron
; IDD3N ratio (117.6/142) = 115.94 -- documented interpolation, not measured.
; EIDD1/EIDD2NT/EIDD6 left at stock placeholders: confirmed dead (EIDD1/EIDD6
; parsed but never read by any energy formula; EIDD2NT not even declared in
; Params.h/parsed by Params.cpp -- see cycle-6 EIDD audit).
EIDD0 60.2
EIDD1 54
EIDD2P0 46.87
EIDD2P1 46.87
EIDD2N 49
EIDD2NT 37
EIDD3P 115.94
EIDD3N 117.6
EIDD4R 259
EIDD4W 288
EIDD5B 227
EIDD6 12
;********************************************************************************

;================================================================================
; Memory controller parameters

; Specify which memory controller to use
; options: PerfectMemory, FCFS, FRFCFS, FRFCFS-WQF, DRC (for 3D DRAM Cache)
MEM_CTL FRFCFS

; whether dump the memory request trace?
CTL_DUMP false

; whether use close-page row buffer management policy?
; options: 
;   0--Open-Page, the row will be closed until a row buffer miss occurs
;   1--Relaxed Close-Page, the row will be closed if no other row buffer hit exists
;   2--Restricted Close-Page, the row will be closed immediately, no row
;      buffer hit can be exploited
ClosePage 0

; command scheduling scheme
; options: 0--fixed priority, 1--rank first round-robin, 2--bank first round-robin
ScheduleScheme 2

; address mapping scheme
; options: SA:R:RK:BK:CH:C (SA-Subarray, R-row, C:column, BK:bank, RK:rank, CH:channel)
AddressMappingScheme SA:R:RK:BK:CH:C

; interconnect between controller and memory chips
; options: OffChipBus (for 2D), OnChipBus (for 3D)
INTERCONNECT OffChipBus

; FRFCFS-WQF specific parameters
ReadQueueSize 32 ; read queue size

WriteQueueSize 32 ; write queue size

HighWaterMark 32 ; write drain high watermark. write drain is triggerred if it is reached

LowWaterMark 16 ; write drain low watermark. write drain is stopped if it is reached
;================================================================================

;********************************************************************************
; Simulation control parameters
;
PrintGraphs false
PrintPreTrace false
PreTraceFile mcf.trace
EchoPreTrace false
PeriodicStatsInterval 100000000

TraceReader NVMainTrace
;********************************************************************************

;================================================================================
; Endurance model parameters
; This is used for Non-volatile memory

EnduranceModel NullModel
EnduranceDist Normal
EnduranceDistMean 1000000 
EnduranceDistVariance  100000
FlipNWriteGranularity 32

; Everything below this can be overridden for heterogeneous channels
;CONFIG_CHANNEL0 lp_rram.config
;CONFIG_CHANNEL1 hp_rram.config

; whether set the DRAM in powerdown mode at the beginning?
InitPD false

IgnoreData true
;================================================================================

;AddHook PostTrace
;PostTraceFile drampower2.trace
;PostTraceWriter DRAMPower2Trace
;DRAMPower2XML nvmain_config.xml 

